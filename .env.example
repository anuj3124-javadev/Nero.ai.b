# ============================================
#   AI-SaaS Server - Environment Variables
# ============================================

# Server Port (Render will provide this automatically)
PORT=3000

# ── Database (Required for both local and live) ──
# For live, use a service like Aiven or PlanetScale.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_saas_db
DB_USER=root
DB_PASS=root
DB_SSL=false

# ── Clerk Authentication ──────────────────────
# Get from: https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# ── AI Services ────────────────────────────────
# Mistral (Article generation): https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# Clipdrop (Image Generation): https://clipdrop.co/apis
CLIPDROP_API_KEY=your_clipdrop_api_key_here

# Hugging Face (Alternative Image Gen): https://huggingface.co/settings/tokens
HUGGING_FACE_TOKEN=your_hugging_face_token_here

# ── Image Storage ──────────────────────────────
# Cloudinary: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
